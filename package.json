{
  "name": "back-in-stock-alerts",
  "version": "1.0.0",
  "private": true,
  "description": "Back-in-stock notification service: subscription form, verified stock webhooks, durable email outbox, admin dashboard.",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=.env src/server.js",
    "test": "node --test test/*.test.js",
    "test:docker": "bash scripts/docker-smoke-test.sh",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  }
}
